{
  "name": "git-mistake-tracker",
  "displayName": "git-mistake-tracker",
  "description": "Tracks down git line authors and errors",
  "version": "1.0.0",
  "icon": "icon.png",
  "publisher": "clarissa-dev-codes",
  "engines": {
    "vscode": "^1.140.0"
  },
  "categories": [
    "Other",
    "Testing",
    "Debuggers"
  ],
  "activationEvents": [
    "onLanguage:javascript",
    "onLanguage:typescript",
    "onLanguage:python"
  ],
  "main": "./dist/extension.js",
  "repository":{
    "type": "git",
    "url": "https://github.com/clarissa-dev-codes/git-mistake-tracker"
  },
  "contributes": {
    "commands":[
      {
        "command": "git-mistake-tracker.openIssue",
        "title": "Report Git Mistake"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "^1.140.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "eslint": "^10.5.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
